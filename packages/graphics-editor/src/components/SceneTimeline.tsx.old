import { useState, type FC } from "react";
import type { AnimatedProperty, Graphics3DAnimatedProperty, Graphics3DAnimationTarget, Layer, SceneTransitionType } from "../types";
import type { SceneTimeline as Timeline } from "../types";
import { createClip, createKeyframe, createTrack, duplicateTimeline, duplicateScene, insertEmptyScene, timelineDuration, upsertKeyframe, moveKeyframe, removeKeyframe, setClip, removeClip, resizeClip, moveClip, setSceneTransition, setLoop } from "../timeline";
import { add3DTrack, upsert3DKeyframe, move3DKeyframe, remove3DKeyframe } from "../3d-timeline";

const PROPERTIES:AnimatedProperty[]=["x","y","width","height","rotation","opacity"];
const THREE_D_PROPERTIES:Graphics3DAnimatedProperty[]=["positionX","positionY","positionZ","rotationX","rotationY","rotationZ","scaleX","scaleY","scaleZ","fov","opacity","visibility"];
const TRANSITIONS:SceneTransitionType[]=["cut","fade","dissolve","slide-left","slide-right","slide-up","slide-down"];

type SelectedKey={kind:"2d"|"3d";trackId:string;keyId:string};

export const SceneTimelinePanel:FC<{timeline:Timeline;layers:Layer[];onChange:(timeline:Timeline)=>void;onSeek:(time:number)=>void}>=({timeline,layers,onChange,onSeek})=>{
 const[selectedKey,setSelectedKey]=useState<SelectedKey|null>(null);
 const[expanded,setExpanded]=useState<Set<string>>(()=>new Set());
 const total=Math.max(1,timelineDuration(timeline));
 const toTime=(x:number,r:DOMRect)=>Math.max(0,Math.min(total,(x-r.left)/r.width*total));
 const addTrack=(id:string,p:AnimatedProperty)=>{if(timeline.tracks.some(t=>t.layerId===id&&t.property===p))return;onChange({...timeline,tracks:[...timeline.tracks,createTrack(id,p)]})};
 const addKey=(layer:Layer,p:AnimatedProperty)=>{const t=timeline.tracks.find(x=>x.layerId===layer.id&&x.property===p);if(!t)return;const value=p==="rotation"?(layer.rotation??0):p==="opacity"?Number(layer.style?.opacity??1):Number(layer[p]);const scene=timeline.scenes.find(s=>timeline.currentTime>=s.start&&timeline.currentTime<=s.start+s.duration)??timeline.scenes[0];const time=scene?Math.max(scene.start,Math.min(timeline.currentTime,scene.start+scene.duration)):timeline.currentTime;const key=createKeyframe(time,value);onChange({...timeline,tracks:timeline.tracks.map(x=>x.id===t.id?upsertKeyframe(x,key):x)});setSelectedKey({kind:"2d",trackId:t.id,keyId:key.id})};
 const add3DKey=(targetType:Graphics3DAnimationTarget,targetId:string,p:Graphics3DAnimatedProperty,base:number)=>{let t=timeline.tracks3d?.find(x=>x.targetType===targetType&&x.targetId===targetId&&x.property===p);let next=timeline;if(!t){next=add3DTrack(timeline,targetType,targetId,p);t=next.tracks3d?.at(-1)}if(!t)return;const key=createKeyframe(timeline.currentTime,base);next={...next,tracks3d:(next.tracks3d??[]).map(x=>x.id===t!.id?upsert3DKeyframe(next,x.id,key).tracks3d!.find(y=>y.id===x.id)!:x)};onChange(next);setSelectedKey({kind:"3d",trackId:t.id,keyId:key.id})};
 const updateKey=(kind:"2d"|"3d",trackId:string,keyId:string,time:number)=>onChange(kind==="2d"?{...timeline,tracks:timeline.tracks.map(t=>t.id===trackId?moveKeyframe(t,keyId,time):t)}:{...timeline,tracks3d:(timeline.tracks3d??[]).map(t=>t.id===trackId?move3DKeyframe(timeline,trackId,keyId,time).tracks3d!.find(x=>x.id===trackId)!:t)});
 const deleteKey=(kind:"2d"|"3d",trackId:string,keyId:string)=>{onChange(kind==="2d"?{...timeline,tracks:timeline.tracks.map(t=>t.id===trackId?removeKeyframe(t,keyId):t)}:{...timeline,tracks3d:(timeline.tracks3d??[]).map(t=>t.id===trackId?remove3DKeyframe(timeline,trackId,keyId).tracks3d!.find(x=>x.id===trackId)!:t)});if(selectedKey?.keyId===keyId)setSelectedKey(null)};
 const patchKey=(kind:"2d"|"3d",trackId:string,keyId:string,patch:Partial<{value:number;easing:"linear"|"ease-in"|"ease-out"|"ease-in-out"}>)=>onChange(kind==="2d"?{...timeline,tracks:timeline.tracks.map(t=>t.id===trackId?{...t,keyframes:t.keyframes.map(k=>k.id===keyId?{...k,...patch}:k)}:t)}:{...timeline,tracks3d:(timeline.tracks3d??[]).map(t=>t.id===trackId?{...t,keyframes:t.keyframes.map(k=>k.id===keyId?{...k,...patch}:k)}:t)});
 const selected=selectedKey?(selectedKey.kind==="2d"?timeline.tracks.find(t=>t.id===selectedKey.trackId)?.keyframes.find(k=>k.id===selectedKey.keyId):timeline.tracks3d?.find(t=>t.id===selectedKey.trackId)?.keyframes.find(k=>k.id===selectedKey.keyId)):undefined;
 const addClip=(id:string)=>onChange(setClip(timeline,createClip(id,0,total)));const clipFor=(id:string)=>timeline.clips?.find(c=>c.layerId===id);const updateClip=(id:string,start:number,duration:number)=>onChange(resizeClip(timeline,id,start,duration));
 const selectScene=(id:string)=>{const scene=timeline.scenes.find(s=>s.id===id);if(scene)onSeek(scene.start)};
 const toggle=(id:string)=>setExpanded(s=>{const n=new Set(s);if(n.has(id))n.delete(id);else n.add(id);return n});
 const keyMarkers=(kind:"2d"|"3d",trackId:string)=>(kind==="2d"?timeline.tracks.find(t=>t.id===trackId)?.keyframes:timeline.tracks3d?.find(t=>t.id===trackId)?.keyframes)?.map(k=><button key={k.id} className={selectedKey?.keyId===k.id?"ge-key ge-key-selected":"ge-key"} style={{left:`${k.time/total*100}%`}} onPointerDown={e=>{e.stopPropagation();setSelectedKey({kind,trackId,keyId:k.id});const body=e.currentTarget.parentElement!.getBoundingClientRect();const move=(ev:PointerEvent)=>updateKey(kind,trackId,k.id,toTime(ev.clientX,body));const up=()=>{window.removeEventListener("pointermove",move);window.removeEventListener("pointerup",up)};window.addEventListener("pointermove",move);window.addEventListener("pointerup",up)}} onDoubleClick={()=>deleteKey(kind,trackId,k.id)} title="Double-click to delete">◆</button>);
 const render3DTrack=(targetType:Graphics3DAnimationTarget,targetId:string,p:Graphics3DAnimatedProperty)=>{const t=timeline.tracks3d?.find(x=>x.targetType===targetType&&x.targetId===targetId&&x.property===p);return <div className="ge-3d-property" key={p}><button onClick={()=>t?undefined:add3DKey(targetType,targetId,p,0)}>{p}{t?` · ${t.keyframes.length}`:" +"}</button>{t&&<div className="ge-track-key-area">{keyMarkers("3d",t.id)}</div>}</div>};
 const threeDViews=layers.filter(l=>l.type==="3d-view");
 return <section className="ge-timeline" aria-label="Scene timeline"><div className="ge-timeline-head"><b>Timeline</b><button onClick={()=>onSeek(Math.max(0,timeline.currentTime-.5))}>◀</button><button onClick={()=>onSeek(Math.min(total,timeline.currentTime+.5))}>▶</button><button onClick={()=>onSeek(0)}>● 0</button><label><input type="checkbox" checked={!!timeline.loop} onChange={e=>onChange(setLoop(timeline,e.target.checked))}/> Loop</label><button title="Duplicate the complete timeline after itself" onClick={()=>{const end=timelineDuration(timeline);onChange(duplicateTimeline(timeline,end));}}>⧉ Duplicate timeline</button><span>{timeline.currentTime.toFixed(2)}s / {total.toFixed(2)}s</span></div>
 <div className="ge-timeline-ruler" style={{gridTemplateColumns:`repeat(${Math.max(1,Math.ceil(total))},1fr)`}}>{Array.from({length:Math.ceil(total)+1},(_,i)=><span key={i}>{i}s</span>)}</div>
 <div className="ge-timeline-body" onPointerDown={e=>{const r=e.currentTarget.getBoundingClientRect();onSeek(toTime(e.clientX,r));}}>{timeline.scenes.map(s=><button key={s.id} className="ge-scene" style={{left:`${s.start/total*100}%`,width:`${s.duration/total*100}%`}} onClick={e=>{e.stopPropagation();selectScene(s.id)}}>{s.name}<span className="ge-scene-actions"><button type="button" title="Duplicate scene" onClick={e=>{e.stopPropagation();onChange(duplicateScene(timeline,s.id))}}>⧉</button><button type="button" title="Insert empty scene after" onClick={e=>{e.stopPropagation();const i=timeline.scenes.findIndex(x=>x.id===s.id);onChange(insertEmptyScene(timeline,i+1))}}>＋</button></span></button>)}{timeline.tracks.map(t=>t.keyframes.map(k=><button key={k.id} className={selectedKey?.keyId===k.id?"ge-key ge-key-selected":"ge-key"} style={{left:`${k.time/total*100}%`}} onPointerDown={e=>{e.stopPropagation();setSelectedKey({kind:"2d",trackId:t.id,keyId:k.id});const body=e.currentTarget.parentElement!.getBoundingClientRect();const move=(ev:PointerEvent)=>updateKey("2d",t.id,k.id,toTime(ev.clientX,body));const up=()=>{window.removeEventListener("pointermove",move);window.removeEventListener("pointerup",up)};window.addEventListener("pointermove",move);window.addEventListener("pointerup",up)}} onDoubleClick={()=>deleteKey("2d",t.id,k.id)} title={`${t.property}: ${k.value} — double-click to delete`}>◆</button>))}</div>
 <div className="ge-track-list"><div className="ge-timeline-subhead">Scenes & objects</div>{timeline.scenes.map(scene=><div className="ge-scene-tree" key={scene.id}><button className="ge-tree-row ge-tree-scene" onClick={()=>{selectScene(scene.id);toggle(`scene:${scene.id}`)}}>▾ {scene.name}</button>{expanded.has(`scene:${scene.id}`)&&layers.filter(l=>l.type!=="group"&&l.type!=="3d-view").map(layer=>{const clip=clipFor(layer.id);return <div className="ge-tree-object" key={`${scene.id}:${layer.id}`}><b>{layer.text||layer.id}</b><div className="ge-clip-cell">{clip?<div className="ge-clip" style={{left:`${clip.start/total*100}%`,width:`${clip.duration/total*100}%`}}><span>clip</span><button onClick={()=>onChange(moveClip(timeline,clip.id,Math.max(0,clip.start-.25)))}>◀</button><button onClick={()=>onChange(moveClip(timeline,clip.id,Math.min(Math.max(0,total-clip.duration),clip.start+.25)))}>▶</button><input aria-label="Clip start" type="number" step=".1" value={clip.start} onChange={e=>updateClip(clip.id,Number(e.target.value)||0,clip.duration)}/><input aria-label="Clip duration" type="number" min=".1" step=".1" value={clip.duration} onChange={e=>updateClip(clip.id,clip.start,Number(e.target.value)||.1)}/><button onClick={()=>onChange(removeClip(timeline,clip.id))}>×</button></div>:<button onClick={()=>addClip(layer.id)}>+ clip</button>}</div><div className="ge-property-buttons">{PROPERTIES.map(p=>{const t=timeline.tracks.find(x=>x.layerId===layer.id&&x.property===p);return <button key={p} onClick={()=>t?addKey(layer,p):addTrack(layer.id,p)}>{p}{t?` · ${t.keyframes.length}`:" +"}</button>})}</div></div>})}</div>)}
 {threeDViews.map(viewLayer=>{const viewId=viewLayer.view3dId??viewLayer.id;const objectIds=[...new Set((timeline.tracks3d??[]).filter(t=>t.targetType==="mesh").map(t=>t.targetId))];const cameraIds=[...new Set((timeline.tracks3d??[]).filter(t=>t.targetType==="camera").map(t=>t.targetId))];return <div className="ge-3d-tree" key={viewLayer.id}><button className="ge-tree-row ge-tree-view" onClick={()=>toggle(`view:${viewId}`)}>▾ ◈ {viewLayer.text||"3D View"}</button>{expanded.has(`view:${viewId}`)&&<div className="ge-3d-children"><div className="ge-tree-label">View</div>{["opacity","visibility"].map(p=>render3DTrack("view",viewId,p as Graphics3DAnimatedProperty))}<div className="ge-tree-label">Objects</div>{objectIds.length?objectIds.map(id=><div className="ge-3d-object" key={id}><b>◆ {id}</b>{THREE_D_PROPERTIES.filter(p=>p.startsWith("position")||p.startsWith("rotation")||p.startsWith("scale")).map(p=>render3DTrack("mesh",id,p))}</div>):<div className="ge-tree-empty">No animated 3D objects yet</div>}<div className="ge-tree-label">Cameras</div>{cameraIds.length?cameraIds.map(id=><div className="ge-3d-object" key={id}><b>◉ {id}</b>{(["positionX","positionY","positionZ","rotationX","rotationY","rotationZ","fov"] as Graphics3DAnimatedProperty[]).map(p=>render3DTrack("camera",id,p))}</div>):<div className="ge-tree-empty">No animated 3D cameras yet</div>}</div>}</div>})}</div>
 <div className="ge-scene-controls"><b>Scene transitions</b>{timeline.scenes.map((scene,i)=><div className="ge-scene-control" key={scene.id}><span>{scene.name}{i===timeline.scenes.length-1?"":" →"}</span>{i<timeline.scenes.length-1&&<><select value={scene.transition?.type??"cut"} onChange={e=>onChange(setSceneTransition(timeline,scene.id,e.target.value as SceneTransitionType,scene.transition?.duration??.5))}>{TRANSITIONS.map(t=><option key={t} value={t}>{t}</option>)}</select><input type="number" min="0" max={scene.duration} step=".1" value={scene.transition?.duration??0} onChange={e=>onChange(setSceneTransition(timeline,scene.id,scene.transition?.type??"cut",Number(e.target.value)||0))}/><span>s</span></>}</div>)}</div>
 {selected&&selectedKey&&<div className="ge-key-editor"><b>Keyframe</b><label>Time<input type="number" min="0" step="0.01" value={selected.time} onChange={e=>updateKey(selectedKey.kind,selectedKey.trackId,selected.id,Number(e.target.value)||0)}/></label><label>Value<input type="number" step="0.01" value={selected.value} onChange={e=>patchKey(selectedKey.kind,selectedKey.trackId,selected.id,{value:Number(e.target.value)||0})}/></label><label>Easing<select value={selected.easing??"linear"} onChange={e=>patchKey(selectedKey.kind,selectedKey.trackId,selected.id,{easing:e.target.value as "linear"|"ease-in"|"ease-out"|"ease-in-out"})}><option value="linear">Linear</option><option value="ease-in">Ease in</option><option value="ease-out">Ease out</option><option value="ease-in-out">Ease in/out</option></select></label><button onClick={()=>deleteKey(selectedKey.kind,selectedKey.trackId,selected.id)}>Delete keyframe</button></div>}
 <div className="ge-playhead" style={{left:`${Math.min(100,timeline.currentTime/total*100)}%`}}/></section>;
};
