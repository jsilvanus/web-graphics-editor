{
  "version": 2,
  "name": "WEGRA Test Pyramid",
  "floors": [
    {
      "id": "unit",
      "description": "Independent foundational tests. Every suite runs even when another suite fails.",
      "failFast": false,
      "suites": [
        {"id":"animation","files":["src/animation.test.ts"]},
        {"id":"animation-edge","files":["src/animation.edge.test.ts"]},
        {"id":"animation-comprehensive","files":["src/animation-comprehensive.test.ts"]},
        {"id":"model-primitives","files":["src/model.primitives.test.ts"]},
        {"id":"geometry","files":["src/geometry.test.ts"]},
        {"id":"world-time","files":["src/world-time.test.ts"]}
      ]
    },
    {
      "id": "model",
      "needs": ["unit"],
      "description": "Document, history, timeline and architectural model contracts.",
      "failFast": false,
      "suites": [
        {"id":"serialization","files":["src/serialization.test.ts"]},
        {"id":"serialization-edge","files":["src/serialization.edge.test.ts"]},
        {"id":"timelineCommands","files":["src/timelineCommands.test.ts"]},
        {"id":"scene-timeline","files":["src/scene-timeline.test.ts"]},
        {"id":"viewport-output","files":["src/viewport-output.test.ts"]},
        {"id":"world-view","files":["src/world-view.test.ts"]}
      ]
    },
    {
      "id": "integration",
      "needs": ["model"],
      "description": "Cross-layer presentation and runtime contracts.",
      "failFast": false,
      "suites": [
        {"id":"presentation","files":["src/presentation.test.ts"]},
        {"id":"architecture.integration","files":["src/architecture.integration.test.ts"]},
        {"id":"output","files":["src/output.test.ts"]}
      ]
    },
    {
      "id": "package",
      "needs": ["integration"],
      "description": "Complete package verification: tests, types and build.",
      "failFast": true,
      "commands": [
        "npm run typecheck --workspace @jsilvanus/graphics-editor",
        "npm test --workspace @jsilvanus/graphics-editor",
        "npm run build --workspace @jsilvanus/graphics-editor"
      ]
    }
  ]
}
