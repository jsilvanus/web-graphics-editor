{
  "version": 3,
  "name": "WEGRA Test Pyramid",
  "policy": {
    "everyTestFileMustBelongToExactlyOneSuite": true,
    "suitePathsAreRelativeTo": "packages/graphics-editor"
  },
  "floors": [
    {
      "id": "unit",
      "description": "Fast foundational model and algorithm tests. Every suite runs independently.",
      "failFast": false,
      "suites": [
        {"id":"animation","files":["src/animation.test.ts","src/animation.edge.test.ts","src/animation-comprehensive.test.ts","src/animation-engine.test.ts"]},
        {"id":"geometry","files":["src/geometry.test.ts","src/geometry/path.test.ts","src/spatial-interpolation.test.ts"]},
        {"id":"3d-core","files":["src/3d.test.ts","src/3d-animation.test.ts","src/3d-mesh.test.ts"]},
        {"id":"3d-rendering","files":["src/3d-renderer.test.ts","src/3d-render-cache.test.ts"]},
        {"id":"mesh-topology","files":["src/mesh/validate.test.ts","src/mesh/half-edge.test.ts","src/mesh/graphics-mesh.test.ts","src/mesh/split-edge.test.ts","src/mesh/delete-vertices.test.ts","src/mesh/weld-vertices.test.ts","src/mesh/translate-faces.test.ts","src/mesh/extrude/extrude-region.test.ts","src/mesh/bevel/bevel-edge.test.ts"]},
        {"id":"document-model","files":["src/model-primitives.test.ts","src/document.test.ts","src/layer-tree.test.ts","src/render-model.test.ts"]},
        {"id":"world-animation","files":["src/world-animation.test.ts","src/world-time.test.ts","src/world-keyframe-edit.test.ts"]}
      ]
    },
    {
      "id": "model",
      "needs": ["unit"],
      "description": "Document, history, serialization, timeline and reference-integrity contracts.",
      "failFast": false,
      "suites": [
        {"id":"serialization","files":["src/serialization.test.ts","src/serialization.edge.test.ts","src/wegra.test.ts"]},
        {"id":"history","files":["src/history/store.test.ts","src/history/operations.test.ts","src/history/worldOperations.test.ts","src/history/worldResolver.test.ts"]},
        {"id":"document-commands","files":["src/document/commands.comprehensive.test.ts","src/document/timelineCommands.test.ts"]},
        {"id":"scene-timeline","files":["src/scene-timeline.test.ts"]},
        {"id":"viewport-output","files":["src/viewport-output.test.ts"]},
        {"id":"world-view","files":["src/world-view.test.ts"]},
        {"id":"reference-integrity","files":["src/validate-references.test.ts"]}
      ]
    },
    {
      "id": "integration",
      "needs": ["model"],
      "description": "Cross-layer presentation, persistence and runtime contracts.",
      "failFast": false,
      "suites": [
        {"id":"presentation","files":["src/presentation.test.ts","src/presentation.property.test.ts","src/presentation.integration.test.ts"]},
        {"id":"architecture","files":["src/architecture.integration.test.ts"]},
        {"id":"persistence","files":["src/editing-persistence.integration.test.ts"]},
        {"id":"world-view-integration","files":["src/world-view.integration.test.ts","src/world-view-integration.test.ts"]},
        {"id":"outputs","files":["src/outputs-runtime.test.ts","src/output-controller.comprehensive.test.ts"]}
      ]
    },
    {
      "id": "package",
      "needs": ["integration"],
      "description": "Complete package verification: full test suite, types and build.",
      "failFast": true,
      "commands": [
        "npm run typecheck --workspace @jsilvanus/graphics-editor",
        "npm test --workspace @jsilvanus/graphics-editor",
        "npm run build --workspace @jsilvanus/graphics-editor"
      ]
    }
  ]
}
