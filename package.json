{
  "name": "@jsilvanus/web-graphics-editors",
  "version": "0.0.1",
  "private": true,
  "description": "Reusable web-based editors for graphics, video timelines, and related visual editing workflows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jsilvanus/graphics-editor-demo",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\" \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/*/*.{ts,json,html}\" \"packages/*/*.json\" \"*.json\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\" \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/*/*.{ts,json,html}\" \"packages/*/*.json\" \"*.json\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
